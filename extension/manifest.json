{
  "manifest_version": 3,
  "name": "Foldreel",
  "version": "1.0.0",
  "description": "Send the current tab or a link straight to Foldreel, running on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Send this page to Foldreel",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hover.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["activeTab", "storage", "contextMenus", "webRequest", "cookies"],
  "host_permissions": ["http://127.0.0.1:8767/*", "<all_urls>"]
}
