{
  "manifest_version": 3,
  "name": "Foldreel",
  "version": "1.2.0",
  "description": "Send the current tab or a link straight to Foldreel, running on this computer. Also blocks pop-ups and invisible click-catching layers.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Send this page to Foldreel",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popups-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["popups.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["hover.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Send this page to Foldreel"
    }
  },
  "permissions": ["activeTab", "storage", "contextMenus", "webRequest", "cookies"],
  "host_permissions": ["http://127.0.0.1:8767/*", "<all_urls>"]
}
